<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Goat Clicker</title>
    <style>
        body {
            margin: 0;
            padding: 20px;
            background: #1e293b;
            color: #ffffff;
            font-family: Arial, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        .game-container {
            text-align: center;
            background: #334155;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
            max-width: 400px;
            width: 100%;
        }
        #goat {
            font-size: 100px;
            background: none;
            border: none;
            cursor: pointer;
            outline: none;
            transition: transform 0.1s ease;
            margin: 20px 0;
        }
        #goat:active {
            transform: scale(0.9);
        }
        .stats {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 10px;
            color: #38bdf8;
        }
        .gps {
            font-size: 14px;
            color: #94a3b8;
            margin-bottom: 20px;
        }
        .shop {
            margin-top: 20px;
            border-top: 2px solid #475569;
            padding-top: 15px;
        }
        .shop h3 {
            margin-bottom: 10px;
        }
        .upgrade-btn {
            background: #0ea5e9;
            color: #fff;
            border: none;
            padding: 10px 15px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            font-weight: bold;
            width: 100%;
            margin-top: 8px;
            transition: background 0.2s;
        }
        .upgrade-btn:hover {
            background: #0284c7;
        }
        .upgrade-btn:disabled {
            background: #475569;
            color: #94a3b8;
            cursor: not-allowed;
        }
    </style>
</head>
<body>

    <div class="game-container">
        <h1>Goat Clicker</h1>
        <div class="stats">Hooves: <span id="score">0</span></div>
        <div class="gps">per second: <span id="gps">0</span></div>

        <button id="goat" onclick="clickGoat()">🐐</button>

        <div class="shop">
            <h3>Shop</h3>
            <button class="upgrade-btn" id="clickerBtn" onclick="buyClicker()">
                Buy Auto-Climber (Cost: <span id="clickerCost">15</span>) | Owned: <span id="clickerCount">0</span>
            </button>
            <button class="upgrade-btn" id="herdBtn" onclick="buyHerd()">
                Buy Mountain Herd (Cost: <span id="herdCost">100</span>) | Owned: <span id="herdCount">0</span>
            </button>
        </div>
    </div>

    <script>
        let score = 0;
        let gps = 0;

        // Upgrades data
        let clicker = { count: 0, cost: 15, gps: 1 };
        let herd = { count: 0, cost: 100, gps: 5 };

        const scoreElement = document.getElementById("score");
        const gpsElement = document.getElementById("gps");
        
        const clickerCostElement = document.getElementById("clickerCost");
        const clickerCountElement = document.getElementById("clickerCount");
        const clickerBtn = document.getElementById("clickerBtn");

        const herdCostElement = document.getElementById("herdCost");
        const herdCountElement = document.getElementById("herdCount");
        const herdBtn = document.getElementById("herdBtn");

        function clickGoat() {
            score++;
            updateDisplay();
        }

        function buyClicker() {
            if (score >= clicker.cost) {
                score -= clicker.cost;
                clicker.count++;
                gps += clicker.gps;
                clicker.cost = Math.floor(clicker.cost * 1.15);
                updateDisplay();
            }
        }

        function buyHerd() {
            if (score >= herd.cost) {
                score -= herd.cost;
                herd.count++;
                gps += herd.gps;
                herd.cost = Math.floor(herd.cost * 1.15);
                updateDisplay();
            }
        }

        function updateDisplay() {
            scoreElement.textContent = Math.floor(score);
            gpsElement.textContent = gps;

            clickerCostElement.textContent = clicker.cost;
            clickerCountElement.textContent = clicker.count;
            clickerBtn.disabled = score < clicker.cost;

            herdCostElement.textContent = herd.cost;
            herdCountElement.textContent = herd.count;
            herdBtn.disabled = score < herd.cost;
        }

        // Game Loop for passive income
        setInterval(() => {
            if (gps > 0) {
                score += gps / 10;
                updateDisplay();
            }
        }, 100);
    </script>
</body>
</html>
